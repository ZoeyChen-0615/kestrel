# Chat model: any OpenAI-compatible endpoint.
KESTREL_BASE_URL=https://api.deepseek.com
KESTREL_API_KEY=
KESTREL_MODEL=deepseek-chat

# Embeddings for episodic memory. Leave the key empty to use the offline hashing fallback
# (works without network, but retrieval quality is much lower).
KESTREL_EMBED_BASE_URL=https://api.openai.com/v1
KESTREL_EMBED_API_KEY=
KESTREL_EMBED_MODEL=text-embedding-3-small

# ask (default): risky tools need your confirmation | auto: run without asking | readonly: no writes or commands
KESTREL_APPROVAL=ask

# Where state lives (database, workspace, memory files).
# KESTREL_HOME=~/.kestrel
# KESTREL_MCP_CONFIG=./mcp_servers.json

# Context window of your model, used to decide when to compact the conversation.
# KESTREL_CONTEXT_WINDOW=64000

# Optional: USD per million tokens, to show an estimated cost in `kestrel trace`.
# KESTREL_PRICE_IN_PER_MTOK=0.27
# KESTREL_PRICE_OUT_PER_MTOK=1.10

# Telegram (optional). Create a bot with @BotFather, put its token here, and list who may use it.
# The allow-list is mandatory: usernames (no @) and/or numeric user ids, comma separated.
# Use a bot that no other program is polling, or Telegram will report a conflict.
# KESTREL_TELEGRAM_TOKEN=
# KESTREL_TELEGRAM_ALLOWED=your_username
